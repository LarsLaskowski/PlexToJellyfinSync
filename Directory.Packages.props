<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- Code analysis (added to every project) -->
    <PackageVersion Include="Reihitsu.Analyzer" Version="1.2.0" />
    <PackageVersion Include="SonarAnalyzer.CSharp" Version="10.36.0.15337" />
    <!-- Runtime -->
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.15" />
    <!-- Test -->
    <PackageVersion Include="MSTest" Version="4.5.2" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
  </ItemGroup>
</Project>