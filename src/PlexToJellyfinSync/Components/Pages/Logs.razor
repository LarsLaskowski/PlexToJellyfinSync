@page "/logs"

<PageTitle>PlexToJellyfinSync - Logs</PageTitle>

<h1>Logs</h1>

<div class="log-toolbar">
    <label>
        Level:
        <select @bind="_minLevel">
            <option value="@LogLevel.Trace">Trace</option>
            <option value="@LogLevel.Debug">Debug</option>
            <option value="@LogLevel.Information">Information</option>
            <option value="@LogLevel.Warning">Warning</option>
            <option value="@LogLevel.Error">Error</option>
        </select>
    </label>
    <input type="text" placeholder="Filter..." @bind="_filter" @bind:event="oninput" />
    <label class="pause">
        <input type="checkbox" @bind="_paused" /> Pause
    </label>
</div>

<table class="log-table">
    <thead>
        <tr>
            <th>Time</th>
            <th>Level</th>
            <th>Category</th>
            <th>Message</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var entry in Filtered())
        {
            <tr class="level-@entry.Level">
                <td>@entry.Timestamp.LocalDateTime.ToString("HH:mm:ss")</td>
                <td>@entry.Level</td>
                <td>@ShortCategory(entry.Category)</td>
                <td>@entry.Message</td>
            </tr>
        }
    </tbody>
</table>
